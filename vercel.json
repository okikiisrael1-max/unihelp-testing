{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://unihelp-app.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/feed",
      "has": [
        { "type": "query", "key": "post", "value": "(?<post>[^&]+)" },
        { "type": "header", "key": "user-agent", "value": "(WhatsApp|TelegramBot|facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot)" }
      ],
      "destination": "/api/share-preview?kind=feed&post=:post"
    },
    {
      "source": "/profile/:id",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(WhatsApp|TelegramBot|facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot)" }
      ],
      "destination": "/api/share-preview?kind=profile&id=:id"
    },
    {
      "source": "/marketplace/:id",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(WhatsApp|TelegramBot|facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot)" }
      ],
      "destination": "/api/share-preview?kind=marketplace&id=:id"
    },
    {
      "source": "/hostels/:id",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(WhatsApp|TelegramBot|facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot)" }
      ],
      "destination": "/api/share-preview?kind=hostel&id=:id"
    },
    {
      "source": "/past-questions/:id",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(WhatsApp|TelegramBot|facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot)" }
      ],
      "destination": "/api/share-preview?kind=past-question&id=:id"
    },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/about/", "destination": "/about/index.html" },
    { "source": "/features", "destination": "/features/index.html" },
    { "source": "/features/", "destination": "/features/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/faq/", "destination": "/faq/index.html" },
    { "source": "/help-center", "destination": "/help-center/index.html" },
    { "source": "/help-center/", "destination": "/help-center/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacy/", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/terms/", "destination": "/terms/index.html" },
    { "source": "/academic-tools", "destination": "/academic-tools/index.html" },
    { "source": "/academic-tools/", "destination": "/academic-tools/index.html" },
    { "source": "/gpa-calculator", "destination": "/gpa-calculator/index.html" },
    { "source": "/gpa-calculator/", "destination": "/gpa-calculator/index.html" },
    { "source": "/cgpa-tracker", "destination": "/cgpa-tracker/index.html" },
    { "source": "/cgpa-tracker/", "destination": "/cgpa-tracker/index.html" },
    { "source": "/university-cbt-practice", "destination": "/university-cbt-practice/index.html" },
    { "source": "/university-cbt-practice/", "destination": "/university-cbt-practice/index.html" },
    { "source": "/past-questions", "destination": "/past-questions/index.html" },
    { "source": "/past-questions/", "destination": "/past-questions/index.html" },
    { "source": "/ai-tutor", "destination": "/ai-tutor/index.html" },
    { "source": "/ai-tutor/", "destination": "/ai-tutor/index.html" },
    { "source": "/student-community", "destination": "/student-community/index.html" },
    { "source": "/student-community/", "destination": "/student-community/index.html" },
    { "source": "/student-chat", "destination": "/student-chat/index.html" },
    { "source": "/student-chat/", "destination": "/student-chat/index.html" },
    { "source": "/student-marketplace", "destination": "/student-marketplace/index.html" },
    { "source": "/student-marketplace/", "destination": "/student-marketplace/index.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
